# TrueHire Environment Configuration
# Copy to .env for local development. Only essential values are uncommented;
# optional overrides below already have safe built-in defaults in server/src/config/env.ts.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# PostgreSQL Database (must begin with postgresql:// or postgres://)
DATABASE_URL=postgresql://career_lens_user:change_me_local_password@localhost:5433/career_lens?schema=public

# Authentication (set a strong >= 32-char secret in production)
JWT_SECRET=truehire-local-dev-jwt-secret-change-in-production

# AI Provider Routing (groq | nvidia | gemini | ollama)
AI_PROVIDER=groq
# GROQ_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# AI_API_KEY=

# Optional Overrides (safe defaults are already built into server/src/config/env.ts)
# DIRECT_URL=postgresql://career_lens_user:change_me_local_password@localhost:5433/career_lens?schema=public
# JWT_REFRESH_SECRET=
# JWT_EXPIRES_IN=7d
# JWT_REFRESH_EXPIRES_IN=7d
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-flash-latest
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_EVALUATION_MODEL=openai/gpt-oss-120b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
# GREENHOUSE_BOARDS=stripe,razorpay,postman,browserstack,chargebee,druva,clevertap,zerodha,cloudflare,vercel,datadog
# ENABLE_STARTUP_JOB_SYNC=true
# JOB_SYNC_INTERVAL_HOURS=6
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_API_BASE_URL=http://localhost:5000/api