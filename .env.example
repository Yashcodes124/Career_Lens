# ============================================================================
# 1. DATABASE CONFIGURATION (PostgreSQL 15 / Supabase / Docker)
# ============================================================================
POSTGRES_DB=career_lens
POSTGRES_USER=career_lens_user
POSTGRES_PASSWORD=your_local_db_password
POSTGRES_PORT=5433

# For Supabase in production:
# - Use the Transaction Pooler (port 6543, ?pgbouncer=true) for DATABASE_URL
# - Use the Direct Connection (port 5432) for DIRECT_URL
DATABASE_URL="postgresql://career_lens_user:@localhost:5433/career_lens?schema=public"
DIRECT_URL="postgresql://career_lens_user:@localhost:5433/career_lens?schema=public"

# ============================================================================
# 2. SERVER & CORS CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development
# Comma-separated allowed frontend origins for CORS (e.g., https://truehire.vercel.app)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ============================================================================
# 3. AUTHENTICATION (JWT)
# ============================================================================
# Must be at least 16 characters
JWT_SECRET=replace-with-a-strong-random-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d

# ============================================================================
# 4. MULTI-PROVIDER AI CONFIGURATION (OpenAI-Compatible SDK)
# ============================================================================
# Option A — Groq (Recommended Primary):
#   AI_PROVIDER=groq
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=qwen/qwen3.8-27b
#
# Option B — NVIDIA NIM:
#   AI_PROVIDER=nvidia
#   AI_BASE_URL=https://integrate.api.nvidia.com/v1
#   AI_MODEL=meta/llama-3.1-70b-instruct
#
# Option C — Google Gemini (OpenAI-compatible endpoint):
#   AI_PROVIDER=gemini
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   AI_MODEL=gemini-2.0-flash
#
# Option D — Ollama (Local offline development):
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=qwen3:4b

AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_MS=60000

# Provider-specific aliases / fallbacks
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_EVALUATION_MODEL=openai/gpt-oss-120b

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# ============================================================================
# 5. ATS JOB BOARD INTEGRATIONS (Greenhouse Public API)
# ============================================================================
GREENHOUSE_BOARDS=stripe,razorpay,swiggy,zomato,zerodha,cloudflare,vercel
GREENHOUSE_BOARD_TOKEN=stripe
GREENHOUSE_COMPANY=stripe
GREENHOUSE_API_KEY=
LEVER_API_KEY=
ASHBY_API_KEY=

# ============================================================================
# 6. FRONTEND CLIENT CONFIGURATION (Vite)
# ============================================================================
VITE_API_BASE_URL=http://localhost:5000/api